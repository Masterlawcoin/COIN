# MasterlawEX P2P escrow testnet deployment template
# Copy values into your local environment or secret manager. Do NOT commit real secrets.

# RPC for one supported testnet only:
# Arc Testnet chainId 5042002 OR Base Sepolia chainId 84532
P2P_RPC_URL=
P2P_EXPECTED_CHAIN_ID=5042002

# Private key must remain local / secret-manager only.
P2P_DEPLOYER_PRIVATE_KEY=

# Exact 6-decimal escrow asset (normally testnet USDC).
P2P_ASSET_ADDRESS=

# Prefer a Safe/multisig or smart-account contract as arbiter.
P2P_ARBITER_ADDRESS=

# Sandbox escape hatch only. Leave false for normal deployments.
P2P_ALLOW_EOA_ARBITER=false
