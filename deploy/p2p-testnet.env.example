# MasterlawEX P2P escrow deployment template — ARC TESTNET ONLY
# Copy values into your local environment or secret manager. Do NOT commit real secrets.

# Canonical Arc Testnet RPC. Any override must still report chainId 5042002 or deployment aborts.
P2P_RPC_URL=https://rpc.testnet.arc.io

# Private key must remain local / secret-manager only.
P2P_DEPLOYER_PRIVATE_KEY=

# Exact 6-decimal escrow asset on Arc Testnet.
P2P_ASSET_ADDRESS=

# Prefer a Safe/multisig or smart-account contract as arbiter.
P2P_ARBITER_ADDRESS=

# ARC sandbox escape hatch only. Leave false for normal deployments.
P2P_ALLOW_EOA_ARBITER=false
